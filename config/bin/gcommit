#!/usr/bin/env bash
set -eo pipefail

if git diff --cached --quiet 2>/dev/null; then
  echo "nothing staged" >&2
  exit 1
fi

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
env_file="${GCOMMIT_ENV_FILE:-$config_dir/gcommit.env}"
if [[ -f "$env_file" ]]; then
  source "$env_file"
fi

prompt_file="$config_dir/skills/commit/commit-prompt.md"
context_script="$config_dir/skills/commit/scripts/commit-context.sh"
if [[ ! -r "$prompt_file" ]]; then
  echo "gcommit: cannot read commit prompt: $prompt_file" >&2
  exit 1
fi
if [[ ! -r "$context_script" ]]; then
  echo "gcommit: cannot read context script: $context_script" >&2
  exit 1
fi

retries="${GCOMMIT_RETRIES:-3}"
delay="${GCOMMIT_RETRY_DELAY:-3}"
agent="${GCOMMIT_AGENT:-commit}"

if [[ ! "$retries" =~ ^[1-9][0-9]*$ ]]; then
  echo "gcommit: GCOMMIT_RETRIES must be a positive integer" >&2
  exit 1
fi

if [[ -n "${GCOMMIT_MODEL:-}" && "${GCOMMIT_MODEL}" != */* ]]; then
  echo "gcommit: GCOMMIT_MODEL must be provider/model (check quoting in $env_file)" >&2
  exit 1
fi

rules="$(cat "$prompt_file")"
context="$(bash "$context_script")"

model="${GCOMMIT_MODEL:-}"
if [[ -z "$model" ]]; then
  if ! command -v jq >/dev/null 2>&1; then
    echo "gcommit: jq is required to resolve the agent's model" >&2
    exit 1
  fi
  agent_url="$(jq -rn --arg agent "$agent" --arg directory "$PWD" '
    "/api/agent/" + ($agent | @uri) + "?location%5Bdirectory%5D=" + ($directory | @uri)
  ')"
  # Pin the full reference: selecting an agent alone can lose its variant.
  if ! model="$(opencode api get "$agent_url" | jq -er '
    if .data == null then error("missing agent data")
    elif .data.model == null then ""
    else .data.model |
      (.providerID + "/" + .id) +
      (if .variant != null and .variant != "" then "#" + .variant else "" end)
    end
  ')"; then
    echo "gcommit: cannot resolve model for agent: $agent" >&2
    exit 1
  fi
fi
if [[ -n "${GCOMMIT_VARIANT:-}" ]]; then
  if [[ -z "$model" ]]; then
    echo "gcommit: GCOMMIT_VARIANT requires GCOMMIT_MODEL or an agent model" >&2
    exit 1
  fi
  model="${model%%#*}#$GCOMMIT_VARIANT"
fi
model_args=()
if [[ -n "$model" ]]; then
  model_args+=(--model "$model")
fi

debug="${GCOMMIT_DEBUG:-0}"
context_args=()
while (($#)); do
  case "$1" in
    -d | --debug) debug=1 ;;
    --)
      shift
      context_args+=("$@")
      break
      ;;
    *) context_args+=("$1") ;;
  esac
  shift
done

arguments=""
if ((${#context_args[@]})); then
  printf -v arguments '%s ' "${context_args[@]}"
  arguments="${arguments% }"
fi

prompt="$(cat <<EOF
Generate a commit message from the snapshot below. The output is piped
verbatim into git commit for the user to edit.

$rules

## Output contract

- Print only the commit message: subject, then (if any) a blank line and body.
- Your first output character must be the start of the subject line.
- Plain text: no markdown formatting, no fenced blocks, no commentary before
  or after, exactly one trailing newline. Plain-text body bullets are allowed.
- If the snapshot shows no staged changes, print nothing.
- Do not load any skills or run any tools. Never run git commit, git add,
  or any mutating command.

## Snapshot

$context

## Caller-supplied context (may be empty)

$arguments
EOF
)"

if [[ "$debug" == 1 ]]; then
  {
    echo "gcommit: agent=$agent model=${model:-<agent default>} retries=$retries delay=$delay"
    echo "gcommit: ---- prompt ----"
    printf '%s\n' "$prompt"
    echo "gcommit: ------------------"
  } >&2
fi

validate_message() {
  local subject="${1%%$'\n'*}" rest summary
  local subject_pattern='^[a-z][a-z0-9-]*(\([^()[:cntrl:]]+\))?!?: ([^[:space:]].*)$'
  validation_error=""
  if [[ -z "${1//[[:space:]]/}" ]]; then
    validation_error="empty response"
  elif printf '%s\n' "$1" | grep -Ei '```|~~~|</?(tool_call(s)?|function|parameter(s)?|think(ing)?|analysis|reasoning|reflection|assistant|command)([[:space:]>:=/]|$)|<\|[^>]*\|>' >/dev/null; then
    validation_error="tool-call, reasoning, or fenced markup in response"
  elif printf '%s\n' "$1" | LC_ALL=C grep '[[:cntrl:]]' >/dev/null; then
    validation_error="control characters in response"
  elif [[ ! "$subject" =~ $subject_pattern ]]; then
    validation_error="expected a Conventional Commit subject"
  else
    summary="${BASH_REMATCH[2]}"
    if ((${#summary} >= 72)) || [[ "$summary" == *. || "$summary" == *[[:space:]] ]]; then
      validation_error="summary must be under 72 characters with no trailing period or whitespace"
    elif [[ "$1" == *$'\n'* ]]; then
      rest="${1#*$'\n'}"
      if [[ "$rest" != $'\n'* ]]; then
        validation_error="body must be separated from the subject by a blank line"
      fi
    fi
  fi
  [[ -z "$validation_error" ]]
}

generate_message() {
  if [[ "$debug" == 1 ]]; then
    opencode run --title "gcommit" --agent "$agent" "${model_args[@]}" "$prompt"
  else
    opencode run --title "gcommit" --agent "$agent" "${model_args[@]}" "$prompt" 2>/dev/null
  fi
}

msg=""
for ((i = 1; i <= retries; i++)); do
  if msg="$(generate_message)"; then
    if validate_message "$msg"; then
      break
    fi
    echo "gcommit: attempt $i rejected: $validation_error" >&2
  else
    echo "gcommit: attempt $i failed: opencode exited with status $?" >&2
  fi
  if [[ "$debug" == 1 && -n "$msg" ]]; then
    printf 'gcommit: ---- rejected response ----\n%s\ngcommit: ---------------------------\n' "$msg" >&2
  fi
  msg=""
  if ((i < retries)); then
    echo "gcommit: attempt $i failed, retrying in ${delay}s..." >&2
    sleep "$delay"
  fi
done

if [[ -z "$msg" ]]; then
  echo "gcommit: no valid commit message after $retries attempts; git commit was not run" >&2
  exit 1
fi

printf '%s\n' "$msg" | git commit --edit -F -
