{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,

  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git restore*": "deny",
      "git checkout --*": "deny",
      "git clean*": "deny",
      "git commit*": "ask",
      "rm -rf*": "ask"
    }
  },

 "mcp": {
    "glab": {
      "type": "local",
      "command": [
        "glab",
        "mcp",
        "serve"
      ],
      "enabled": true
    }
  }
}
